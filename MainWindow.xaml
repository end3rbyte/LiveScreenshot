<Window x:Class="LiveScreenshot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LiveScreenshot" Width="620" SizeToContent="Height" MinWidth="520"
    WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Language="en-US">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow" />
    </Window.CommandBindings>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="34" LastChildFill="True">
            <Button DockPanel.Dock="Right" Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close"
                    ToolTip="Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    Width="44" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" />
            <Button DockPanel.Dock="Right" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize"
                    ToolTip="Minimize" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                    Width="44" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>
        <StackPanel Margin="24,18,24,24">
            <TextBlock Text="LiveScreenshot" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Margin="0,18,0,12">
                <Button x:Name="WindowButton" Content="Open Window Picker" Click="PickWindow" />
                <Button x:Name="StopButton" Content="Stop Capture" Click="StopCapture" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="Status" Text="Idle" TextWrapping="Wrap" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ErrorText" Foreground="#FF9494" TextWrapping="Wrap" />
            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Click="CopyPath" ToolTip="Copy path"
                        AutomationProperties.Name="Copy path" MinWidth="36" Margin="6,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 5,3 H 2 V 13 H 5 M 5,6 H 13 V 16 H 5 Z" />
                </Button>
                <TextBox x:Name="OutputPath" IsReadOnly="True" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Capture file path" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#30323D" />
            <Setter Property="Foreground" Value="#F4F5FA" />
            <Setter Property="BorderBrush" Value="#555968" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#414555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#242631" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#AEBFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9296A4" />
                                <Setter TargetName="Surface" Property="Background" Value="#252731" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#383B48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
